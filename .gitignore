# ==============================================================================
# Vivado & Simulation Artifacts
# ==============================================================================
# Exclude Vivado temporary folders, compile caches, and implementation run files
*.cache/
*.hw/
*.ip_user_files/
*.runs/

# Vivado command logs and journal files
*.jou
*.str
vivado*.log

# xsim compiled object directories, binary waveform databases & intermediate files
course_project.sim/sim_1/behav/xsim/xsim.dir/
course_project.sim/sim_1/behav/xsim/*.pb
course_project.sim/sim_1/behav/xsim/*.ini
course_project.sim/sim_1/behav/xsim/*.wdb
*.wdb

# Intermediate compilation logs
course_project.sim/sim_1/behav/xsim/xvhdl.log
course_project.sim/sim_1/behav/xsim/compile.log

# ==============================================================================
# Python & Environment
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

